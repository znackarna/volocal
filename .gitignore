# Build output
node_modules/
dist/
src-tauri/target/
# Jednorázové měřidlo stranou aplikace; jeho ONNX Runtime je stovky megabajtů.
probe/*/target/
probe/*/vystup-*.txt

# Generated by Tauri during the build
src-tauri/gen/

# Tools and models: gigabytes of third-party binaries, not source.
# The setup wizard downloads them on first run.
bin/
models/

# Translation hand-off files, written by `npm run i18n:export`.
i18n/

# Delivery archives handed over during a session. Working files, not source.
_to_delete/

# Scratch files written while working on the repository with the owner.
# Notes, extracts, anything put here to be read once. Not source.
tmp/

# Audit and analysis notes written during a session. Internal, not documentation.
# Both shapes those names actually take: `volocal-analyza-0.9.0.md` and
# `slozky-analyza.md`. The earlier `*-analyza-*.md` required a hyphen on both
# sides of the word and so matched only the first — the second was versioned.
# Without the hyphens the two are one rule, and `*hodnoceni*.md` follows for
# the same reason rather than waiting to be caught out by the next name.
*analyza*.md
*hodnoceni*.md

# What a portable copy or a dev run writes beside itself. The archive normally
# lives in %APPDATA%, but a portable copy keeps it here — and an archive is the
# user's recordings, which must never reach a repository.
data/
playback-cache/
microphone/
online-media/
prenosna.txt
*.db
*.db-wal
*.db-shm

# Scratch bundle used to render the real components in a browser during review.
.harness/

# Editors and local environment.
.vscode/
.idea/
*.swp
.env
.env.*

*.local
.DS_Store
Thumbs.db
