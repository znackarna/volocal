{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slobot",
  "version": "0.9.0",
  "identifier": "cz.znackarna.whisp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Slobot™",
        "width": 1360,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 660,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/znackarna/slobot-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "ZDE_PATRI_VEREJNY_KLIC"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "značkárna s.r.o.",
    "copyright": "© 2026 značkárna s.r.o.",
    "shortDescription": "Převádí mluvené slovo na text",
    "longDescription": "Slobot převádí mluvené slovo na text. Přepíše nahrávky i videa v češtině a dalších jazycích, rozpozná jednotlivé mluvčí, označí místa, kde si nebyl jistý, a přehrává přesně na slovo. Nahrávky, přepisy i jazykové modely běží na vašem počítači a nic se neodesílá ven.",
    "licenseFile": "LICENSE.txt",
    "windows": {
      "nsis": {
        "languages": ["Czech", "English"],
        "customLanguageFiles": {
          "Czech": "nsis/Czech.nsh"
        },
        "sidebarImage": "nsis/sidebar.bmp",
        "headerImage": "nsis/header.bmp",
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
