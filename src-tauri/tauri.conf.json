{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Volocal",
  "version": "1.2.21",
  "identifier": "cz.znackarna.volocal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:17420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "volocal™",
        "width": 1360,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 660,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' blob: data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/znackarna/volocal/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyRUNFQUVENEUxRTRFMUQKUldRZFRoNU83ZXJzb3R0bHdiakFENStFOHdURTRQRXBLbEJFVHhjZ1owMjQvSU02VVRqQ1B6dlYK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "značkárna s.r.o.",
    "copyright": "© 2026 značkárna s.r.o.",
    "shortDescription": "Převádí mluvené slovo na text",
    "longDescription": "Volocal převádí mluvené slovo na text. Přepíše nahrávky i videa v češtině a dalších jazycích, rozpozná jednotlivé mluvčí, označí místa, kde si nebyl jistý, a přehrává přesně na slovo. Nahrávky, přepisy i jazykové modely běží na vašem počítači a nic se neodesílá ven.",
    "licenseFile": "LICENSE.txt",
    "windows": {
      "nsis": {
        "languages": ["Czech", "English"],
        "customLanguageFiles": {
          "Czech": "nsis/Czech.nsh"
        },
        "sidebarImage": "nsis/sidebar.bmp",
        "headerImage": "nsis/header.bmp",
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
