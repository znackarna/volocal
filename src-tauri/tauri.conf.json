{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whisp",
  "version": "0.9.0",
  "identifier": "cz.znackarna.whisp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Whisp — Převod řeči na text",
        "width": 1360,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 660,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Radomil Martinec",
    "shortDescription": "Přepis zvukových záznamů",
    "windows": {
      "nsis": {
        "languages": ["Czech", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
