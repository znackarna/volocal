{
  "name": "volocal",
  "private": true,
  "version": "1.2.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run i18n:check && npm run docs:check && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "start": "tauri dev",
    "installer": "tauri build --config src-tauri/tauri.ci.conf.json",
    "docs:check": "node scripts/docs-check.mjs",
    "i18n:check": "node scripts/i18n.mjs check",
    "i18n:sync": "node scripts/i18n.mjs sync",
    "i18n:new": "node scripts/i18n.mjs new",
    "i18n:export": "node scripts/i18n.mjs export",
    "i18n:import": "node scripts/i18n.mjs import",
    "i18n:clear": "node scripts/i18n.mjs clear",
    "i18n:approve": "node scripts/i18n.mjs approve"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-opener": "^2.2.2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
